<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ficha de Aluno - IPCA</title>
  <link rel="stylesheet" href="/css/ipca-theme.css">
</head>
<body class="ipca-crud">
  <div class="page-shell">
    <header class="page-hero">
      <h1>Ficha de Aluno</h1>
      <p>Ao guardar a ficha, o estado fica em Rascunho ate submeteres na area do aluno.</p>
      <span class="role-badge">Tipo de utilizador: Aluno</span>
    </header>

    <nav>
      <a href="/aluno">Minha Area</a>
      <a href="/aluno_notas">Minhas Notas</a>
      <a href="/ficha_aluno?action=logout">Terminar sessao</a>
    </nav>

    <% if (message) { %>
      <div class="message <%= type %>"><%= message %></div>
    <% } %>

    <div class="form-box">
      <p><strong>Estado atual da ficha:</strong> <%= statusAtual %></p>
      <form method="post" action="/ficha_aluno" enctype="multipart/form-data">
        <% if (ficha && ficha.foto) { %>
          <img class="photo-preview" src="/ficha_aluno?action=foto" alt="Foto do aluno">
        <% } %>

        <label for="nome">Nome</label>
        <input id="nome" name="nome" type="text" required value="<%= ficha ? ficha.nome : '' %>">

        <label for="idade">Idade</label>
        <input id="idade" name="idade" type="number" min="1" required value="<%= ficha ? ficha.idade : '' %>">

        <label for="telefone">Telefone</label>
        <input id="telefone" name="telefone" type="tel" required value="<%= ficha ? ficha.telefone : '' %>">

        <label for="morada">Morada</label>
        <input id="morada" name="morada" type="text" required value="<%= ficha ? ficha.morada : '' %>">

        <label for="nif">NIF</label>
        <input id="nif" name="nif" type="text" required value="<%= ficha ? ficha.nif : '' %>">

        <label for="data_nascimento">Data de nascimento</label>
        <input id="data_nascimento" name="data_nascimento" type="date" required value="<%= ficha && ficha.dataNascimento ? new Date(ficha.dataNascimento).toISOString().slice(0,10) : '' %>">

        <label for="foto">Foto</label>
        <input id="foto" name="foto" type="file" accept="image/*" <%= ficha ? '' : 'required' %>>

        <button type="submit"><%= ficha ? 'Guardar ficha' : 'Criar ficha' %></button>
      </form>
    </div>
  </div>
</body>
</html>
