PORT=3000
MONGODB_URI=mongodb+srv://<utilizador>:<password>@<cluster>/ipcapw?retryWrites=true&w=majority
MONGODB_DB=ipcapw
SESSION_SECRET=trocar-este-secret

# Ajusta conforme carga real da aplicacao
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_IDLE_TIME_MS=300000
MONGODB_CONNECT_TIMEOUT_MS=8000
MONGODB_SOCKET_TIMEOUT_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
